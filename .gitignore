node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Agent worktrees (one checkout per branch, never part of the repo)
.claude/worktrees/

# Local database dumps (contain password hashes and settings - never commit)
backups/
tools/.cache/

# Rejected dinosaur models (game rips, non-dinosaurs) are never shipped; credits stay tracked
apps/web/public/kosmo/static/models/dinosaurs/_quarantine/

# Python tooling in the logo labs
__pycache__/
*-logos/venv/

# Root-level render checks (scratch screenshots)
/*.png
